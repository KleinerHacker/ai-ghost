<!--
  Logging of AI Ghost. The console is what a user watching the application sees, so it stays at INFO.
  The file is what a bug report is written from and therefore also carries DEBUG.

  The file appender writes through a buffer, so the disk is only touched once a block is full. The
  buffer is flushed when the JVM shuts down, because the shutdown hook of Log4j stops the appenders.
-->
<Configuration status="WARN">
    <Properties>
        <!-- The log lives next to the other user data of the application, not in the working directory. -->
        <Property name="logDir">${sys:user.home}/.ai-ghost/logs</Property>
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger{36} - %msg%n%throwable</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}"/>
            <!-- Everything below INFO is dropped here, no matter what a logger lets through. -->
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </Console>

        <RollingFile name="File"
                     fileName="${logDir}/ai-ghost.log"
                     filePattern="${logDir}/ai-ghost-%d{yyyy-MM-dd}-%i.log.gz"
                     bufferedIO="true"
                     bufferSize="16384"
                     immediateFlush="false">
            <PatternLayout pattern="${pattern}"/>
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <!-- Old logs are worth little; ten files are enough to look back at a past session. -->
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- The application itself is followed down to DEBUG; the appenders decide what is shown. -->
        <Logger name="org.pcsoft.app.aighost" level="DEBUG"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
