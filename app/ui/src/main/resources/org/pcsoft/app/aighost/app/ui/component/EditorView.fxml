<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import org.pcsoft.app.aighost.app.ui.component.ProjectList?>
<fx:root type="BorderPane" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.EditorView">
    <center>
        <SplitPane dividerPositions="0.25">
            <ProjectList fx:id="pnlProjectList" minWidth="250" SplitPane.resizableWithParent="false"/>
            <StackPane>
                <!-- Hard coded on purpose: temporary placeholder until the editing parts exist. -->
                <Label styleClass="editor-placeholder" text="Select an entry in the project tree to edit it."/>
            </StackPane>
        </SplitPane>
    </center>
</fx:root>
