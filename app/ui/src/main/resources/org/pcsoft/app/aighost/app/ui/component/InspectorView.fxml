<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.pcsoft.app.aighost.app.ui.component.base.AiPromptArea?>
<?import org.pcsoft.app.aighost.app.ui.component.base.AiTextField?>
<?import org.pcsoft.app.aighost.app.ui.component.base.AiTextFieldList?>
<fx:root type="BorderPane" styleClass="inspector" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.InspectorView">
    <center>
        <ScrollPane fitToWidth="true" styleClass="inspector-scroll">
            <VBox spacing="10" styleClass="inspector-content">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <TitledPane fx:id="pnlBookSection" styleClass="inspector-section"
                            text="%component.inspector.book.title">
                    <StackPane>
                        <VBox fx:id="boxBookEmpty" styleClass="inspector-empty">
                            <Label styleClass="inspector-empty-label" text="%component.inspector.book.empty"/>
                        </VBox>
                        <VBox fx:id="boxBookFields" spacing="6">
                            <Label styleClass="inspector-label" text="%component.inspector.book.title.label"/>
                            <AiTextField fx:id="txtBookTitle"/>

                            <Label styleClass="inspector-label" text="%component.inspector.book.titleAppendix.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <AiTextFieldList fx:id="lstBookTitleAppendix"/>

                            <Label styleClass="inspector-label" text="%component.inspector.book.author.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <TextField fx:id="txtBookAuthor"/>

                            <Label styleClass="inspector-label" text="%component.inspector.book.copyright.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <TextField fx:id="txtBookCopyright"/>

                            <Label styleClass="inspector-label" text="%component.inspector.book.prompt.content.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <AiPromptArea fx:id="txaBookContentPrompt" prefHeight="120"/>

                            <Label styleClass="inspector-label" text="%component.inspector.book.prompt.style.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <AiPromptArea fx:id="txaBookStylePrompt" prefHeight="120"/>
                        </VBox>
                    </StackPane>
                </TitledPane>

                <TitledPane fx:id="pnlChapterSection" styleClass="inspector-section"
                            text="%component.inspector.chapter.title">
                    <StackPane>
                        <VBox fx:id="boxChapterEmpty" styleClass="inspector-empty">
                            <Label styleClass="inspector-empty-label" text="%component.inspector.chapter.empty"/>
                        </VBox>
                        <VBox fx:id="boxChapterFields" spacing="6">
                            <Label styleClass="inspector-label" text="%component.inspector.chapter.name.label"/>
                            <AiTextField fx:id="txtChapterName"/>

                            <Label styleClass="inspector-label"
                                   text="%component.inspector.chapter.prompt.content.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <AiPromptArea fx:id="txaChapterContentPrompt" prefHeight="120"/>

                            <Label styleClass="inspector-label"
                                   text="%component.inspector.chapter.prompt.style.label">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>
                            <AiPromptArea fx:id="txaChapterStylePrompt" prefHeight="120"/>
                        </VBox>
                        <VBox fx:id="boxBlurbFields" spacing="6">
                            <Label styleClass="inspector-label" text="%component.inspector.blurb.prompt.label"/>
                            <AiPromptArea fx:id="txaBlurbPrompt" prefHeight="120"/>
                        </VBox>
                    </StackPane>
                </TitledPane>
            </VBox>
        </ScrollPane>
    </center>
</fx:root>
