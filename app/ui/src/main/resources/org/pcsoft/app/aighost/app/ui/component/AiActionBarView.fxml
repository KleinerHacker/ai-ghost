<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.pcsoft.app.aighost.app.AiGhostIcons?>
<fx:root type="HBox" fx:id="pnlRoot" styleClass="ai-action-bar" spacing="4" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.AiActionBarView">
    <Button fx:id="btnRewrite" onAction="#actionRewrite">
        <graphic>
            <AiGhostIcons fx:factory="buttonRewrite"/>
        </graphic>
        <tooltip>
            <Tooltip text="%component.aiActionBar.rewrite.tooltip"/>
        </tooltip>
    </Button>
    <Button fx:id="btnExpand" onAction="#actionExpand">
        <graphic>
            <AiGhostIcons fx:factory="buttonExpand"/>
        </graphic>
        <tooltip>
            <Tooltip text="%component.aiActionBar.expand.tooltip"/>
        </tooltip>
    </Button>
    <Button fx:id="btnShorten" onAction="#actionShorten">
        <graphic>
            <AiGhostIcons fx:factory="buttonShorten"/>
        </graphic>
        <tooltip>
            <Tooltip text="%component.aiActionBar.shorten.tooltip"/>
        </tooltip>
    </Button>
</fx:root>
