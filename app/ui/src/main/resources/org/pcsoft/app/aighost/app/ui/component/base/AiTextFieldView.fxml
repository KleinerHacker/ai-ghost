<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import org.pcsoft.app.aighost.app.AiGhostIcons?>
<fx:root type="BorderPane" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.base.AiTextFieldView">
    <center>
        <TextField fx:id="txtValue"/>
    </center>
    <right>
        <Button fx:id="btnCreate" styleClass="ai-create">
            <BorderPane.margin>
                <Insets left="6"/>
            </BorderPane.margin>
            <graphic>
                <AiGhostIcons fx:factory="buttonAiAction"/>
            </graphic>
            <tooltip>
                <Tooltip text="%aiTextField.create.tooltip"/>
            </tooltip>
        </Button>
    </right>
</fx:root>
