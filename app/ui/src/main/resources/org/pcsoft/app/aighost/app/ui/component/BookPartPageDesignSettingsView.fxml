<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import org.pcsoft.app.aighost.app.ui.component.StyleDataEditor?>
<fx:root type="BorderPane" styleClass="book-part-page-design-settings" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.BookPartPageDesignSettingsView">
    <center>
        <VBox spacing="8.0">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>

            <Label text="%component.bookPartPageDesignSettings.title" styleClass="section-heading"/>
            <StyleDataEditor fx:id="titleEditor"/>

            <Label text="%component.bookPartPageDesignSettings.titleAppendix" styleClass="section-heading"/>
            <StyleDataEditor fx:id="titleAppendixEditor"/>

            <Label text="%component.bookPartPageDesignSettings.text" styleClass="section-heading"/>
            <StyleDataEditor fx:id="textEditor"/>
        </VBox>
    </center>
</fx:root>
