<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import org.pcsoft.app.aighost.app.AiGhostIcons?>
<?import org.pcsoft.app.aighost.app.ui.component.AiTextField?>
<fx:root type="BorderPane" styleClass="ai-list-item" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.AiTextFieldListItemView">
    <center>
        <AiTextField fx:id="txtValue"/>
    </center>
    <right>
        <Button fx:id="btnDelete" styleClass="ai-delete">
            <BorderPane.margin>
                <Insets left="6"/>
            </BorderPane.margin>
            <graphic>
                <AiGhostIcons fx:factory="buttonRemove"/>
            </graphic>
            <tooltip>
                <Tooltip fx:id="tipDelete"/>
            </tooltip>
        </Button>
    </right>
</fx:root>
