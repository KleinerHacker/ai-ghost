<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.pcsoft.app.aighost.app.ui.component.GeneralSettings?>
<?import org.pcsoft.app.aighost.app.ui.component.PlaceholderSettings?>
<?import org.pcsoft.app.aighost.app.ui.component.ProjectSettingsTree?>
<BorderPane styleClass="project-settings-content" prefWidth="800.0" prefHeight="600.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.pcsoft.app.aighost.app.ui.dialog.ProjectSettingsDialogView">
    <top>
        <HBox styleClass="project-settings-header" spacing="12.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
            <ImageView fx:id="imgIcon" fitWidth="32.0" fitHeight="32.0" preserveRatio="true"/>
            <Label styleClass="project-settings-caption" text="%dialog.projectSettings.header"/>
        </HBox>
    </top>
    <left>
        <ProjectSettingsTree fx:id="tree" prefWidth="190.0"/>
    </left>
    <center>
        <StackPane fx:id="content">
            <GeneralSettings fx:id="general"/>
            <PlaceholderSettings fx:id="placeholder"/>
        </StackPane>
    </center>
</BorderPane>
