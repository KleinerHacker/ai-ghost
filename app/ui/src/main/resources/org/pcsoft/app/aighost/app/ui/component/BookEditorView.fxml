<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.pcsoft.app.aighost.app.AiGhostIcons?>
<?import org.pcsoft.app.aighost.app.ui.component.base.AiPromptArea?>
<?import org.pcsoft.app.aighost.app.ui.component.base.AiTextField?>
<fx:root type="BorderPane" styleClass="book-editor" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.pcsoft.app.aighost.app.ui.component.BookEditorView">
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="6">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <Label styleClass="book-editor-label" text="%component.bookEditor.title.label"/>
                <AiTextField fx:id="txtTitle"/>

                <Label styleClass="book-editor-label" text="%component.bookEditor.titleAppendix.label">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <VBox fx:id="boxTitleAppendix" spacing="6"/>
                <HBox>
                    <Button fx:id="btnAddTitleAppendix" styleClass="book-editor-add">
                        <graphic>
                            <AiGhostIcons fx:factory="buttonAdd"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="%component.bookEditor.titleAppendix.add.tooltip"/>
                        </tooltip>
                    </Button>
                </HBox>

                <Label styleClass="book-editor-label" text="%component.bookEditor.prompt.content.label">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <AiPromptArea fx:id="txaContentPrompt" prefHeight="140"/>

                <Label styleClass="book-editor-label" text="%component.bookEditor.prompt.style.label">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                </Label>
                <AiPromptArea fx:id="txaStylePrompt" prefHeight="140"/>
            </VBox>
        </ScrollPane>
    </center>
</fx:root>
