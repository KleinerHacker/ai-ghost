<component name="ProjectRunConfigurationManager">
  <!--
    Starts the UI through Gradle. The Gradle run task launches the application on the module path
    via the module plugin, so JavaFX is loaded as a named module and native access is granted -
    launching the main class directly from the IDE would put everything on the classpath and make
    the JVM print the JavaFX and native access warnings.
  -->
  <configuration default="false" name="ghost-ui" type="GradleRunConfiguration" factoryName="Gradle">
    <ExternalSystemSettings>
      <option name="executionName" />
      <option name="externalProjectPath" value="$PROJECT_DIR$" />
      <option name="externalSystemIdString" value="GRADLE" />
      <option name="scriptParameters" value="" />
      <option name="taskDescriptions">
        <list />
      </option>
      <option name="taskNames">
        <list>
          <option value=":app:ai-ghost-ui:run" />
        </list>
      </option>
      <option name="vmOptions" />
    </ExternalSystemSettings>
    <ExternalSystemDebugServerProcess>true</ExternalSystemDebugServerProcess>
    <ExternalSystemReattachDebugProcess>true</ExternalSystemReattachDebugProcess>
    <DebugAllEnabled>false</DebugAllEnabled>
    <RunAsTest>false</RunAsTest>
    <method v="2" />
  </configuration>
</component>
